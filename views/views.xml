<odoo>
  <data>

    <record id="res_user_signature" model="ir.ui.view">
      <field name="name">res.users.form.signature</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_form"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook//page[@name='preferences']/group/group/field[@name='signature']" position="after">
          <field name="user_signature" widget="html" />
        </xpath>
      </field>
    </record>

    <record id="hr_employee_signature" model="ir.ui.view">
      <field name="name">hr.employee.form.signature</field>
      <field name="model">hr.employee</field>
      <field name="inherit_id" ref="hr.view_employee_form"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
          <page string="Signature">
            <field name="user_signature" widget="html"  invisible="not user_id"/>
          </page>
        </xpath>
      </field>
    </record>

    <record id="purchase_order_form" model="ir.ui.view">
    <field name="name">purchase.order.form</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//group/group/field[@name='tax_calculation_rounding_method']" position="after">
        <field name="checked_by"/>
         <field name="confirmed_by" invisible="1"/>
      </xpath>
    </field>
 </record>
  </data>
</odoo>