<odoo>
  <data>

    <record id="paperformat_purchase_order" model="report.paperformat">
      <field name="name">Nexusgreen Purchase Order</field>
      <field name="default" eval="False"/>
      <field name="format">A4</field>
      <field name="orientation">Portrait</field>
      <field name="margin_top">5</field>
      <field name="margin_bottom">10</field>
      <field name="margin_left">7</field>
      <field name="margin_right">7</field>
      <field name="header_line" eval="False"/>
      <field name="header_spacing">0</field>
      <field name="dpi">90</field>
    </record>

    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
      <field name="report_name">nexusgreen_custom_print.report_purchaseorder</field>
      <field name="report_file">nexusgreen_custom_print.report_purchaseorder</field>
      <field name="paperformat_id" ref="nexusgreen_custom_print.paperformat_purchase_order"/>
    </record>

    <template id="report_purchaseorder">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
          <t t-call="nexusgreen_custom_print.report_purchaseorder_document" t-lang="o.partner_id.lang"/>
        </t>
      </t>
    </template>

    <template id="report_purchaseorder_document">
      <t t-call="web.basic_layout">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
        <div class="page" style="position:relative;">
          <style> th, td { border: 1px solid #000000 !important; padding: 5px; } img { width: 100%;} .sign {
            width: 100%; height:100%; object-fit: contain; } .sign { max-height: 80px; overflow: hidden; } .watermark { position: fixed;
            z-index:99; top:500px;left:250px; opacity:0.15; } </style>
          <!-- water mark -->
          <div class="col-12 d-flex justify-content-center">
            <t t-if="o.company_logo">
              <!-- <div style="opacity:0.15;
              font-size:100px;text-align:center;top:500px;left:250px;position:fixed;z-index:99;">
                <span style="width:880px;align:center; background-color:red;">
                  <img t-att-src="image_data_uri(o.company_logo)" width="600" height="500" />
                </span>
              </div> -->
              <div class="watermark">
                <img t-att-src="image_data_uri(o.company_logo)" width="700" height="500" />
              </div>
            </t>
          </div>

          <!-- company logo -->
          <div class="row mb-3">
          <div class="col-8"/>
            <div class="col-4 text-center">
              <img t-if="o.company_logo" t-att-src="image_data_uri(o.company_logo)" style="height: auto; width: 75%;" alt="Company Logo"/>
            </div>
          </div>

          <!-- shipping address and vendor details -->
          <div class="row mb-3 ">
            <div class="col-6 py-2">
              <strong>Shipping Address</strong>
              <t t-if="o.dest_address_id">
                <div t-field="o.dest_address_id"
                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
              </t>
              <t t-else="">
                <div t-field="o.company_id.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
              </t>
            </div>
            <div class="col-6  py-2">
              <strong>Vendor Details</strong>
              <div t-field="o.partner_id"
                   t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
            </div>
          </div>

          <!-- purchase order ref -->
          <div class="row py-4">
            <div class="col">
              <div class="fw-bolder">
                <h3>Purchase Order:#<span t-field="o.name" />
                </h3>
              </div>
            </div>
          </div>
          <!-- end of purchase order ref -->

          <!-- represenative section -->
          <div class="row mb-3 ">
            <div class="col-12 border border-dark px-2 py-2">
              <div class="row">
                <div class="col-4">
                  <div>
                    <strong>Representative:</strong>
                  </div>
                  <div>
                    <span t-field="o.user_id" class="m-0" />
                  </div>
                </div>
                <div class="col-4">
                  <div>
                    <strong>Your Order Reference:</strong>
                  </div>
                  <div>
                    <span t-field="o.partner_ref" />
                  </div>
                </div>
                <div class="col-4">
                  <div>
                    <strong>
                      Order Date:
                    </strong>
                  </div>
                  <div>
                    <span t-field="o.date_approve" />
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-4">
                  <div>
                    <strong>Order Deadline:</strong>
                  </div>
                  <div>
                    <span t-field="o.date_order" class="m-0" t-options="{'widget':'date'}" />
                  </div>
                </div>
                <div class="col-4">
                  <div>
                    <strong>Expected Arrival:</strong>
                  </div>
                  <div>
                    <span t-field="o.date_planned" t-options="{'widget':'date'}" />
                  </div>
                </div>

              </div>
            </div>
          </div>
          <!-- end of representative section -->

          <!-- line items section -->
          <div class="row mb-4">
            <div class="col-12">
              <div class="mb-0">
                <table class="table table-sm table-bordered border-black o_main_table border: 1px solid black;">
                  <thead>
                    <tr>
                      <th name="th_description">
                        <strong>Description</strong>
                      </th>
                      <!-- <th name="th_taxes">
                        <strong>Taxes</strong>
                      </th> -->
                      <!-- <th name="th_date_req" class="text-center">
                        <strong>Date Req.</strong>
                      </th> -->
                      <th name="th_quantity" class="text-right">
                        <strong>Qty</strong>
                      </th>
                      <th name="th_price_unit" class="text-right">
                        <strong>Unit Price</strong>
                      </th>
                      <th name="th_amount" class="text-right">
                        <strong>Amount</strong>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <t t-set="current_subtotal" t-value="0" />
                    <t t-foreach="o.order_line" t-as="line">
                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded" />
                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included" />

                      <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                        <t t-if="not line.display_type">
                          <td id="product">
                            <span t-field="line.name" />
                          </td>
                          <!-- <td name="td_taxes">
                            <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))" />
                          </td> -->
                          <!-- <td class="text-center">
                            <span t-field="line.date_planned" />
                          </td> -->
                          <td class="text-right">
                            <span t-field="line.product_qty" />
                            <span t-field="line.product_uom_id.name" groups="uom.group_uom" />
                          </td>
                          <td class="text-right">
                            <span t-field="line.price_unit" />
                          </td>
                          <td class="text-right">
                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                          </td>
                        </t>
                        <t t-if="line.display_type == 'line_section'">
                          <td colspan="99" id="section">
                            <span t-field="line.name" />
                          </td>
                          <t t-set="current_section" t-value="line" />
                          <t t-set="current_subtotal" t-value="0" />
                        </t>
                        <t t-if="line.display_type == 'line_note'">
                          <td colspan="99" id="note">
                            <span t-field="line.name" />
                          </td>
                        </t>
                      </tr>
                      <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                        <tr class="is-subtotal text-right">
                          <td colspan="99" id="subtotal">
                            <strong class="mr16">Subtotal</strong>
                            <span t-esc="current_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                            />
</td>
</tr>
</t>
</t>
</tbody>
</table>
</div>
<div class="my-0">
                              <div id="total" class="row justify-content-end">
                                <div class="col-4">
                                  <table class="table table-sm">
                                    <tr class="border-black">
                                      <td name="td_subtotal_label">
                                        <strong>Subtotal</strong>
                                      </td>
                                      <td class="text-right">
                                        <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                      </td>
                                    </tr>
                                    <tr>
                                      <td name="td_taxes_label">Taxes</td>
                                      <td class="text-right">
                                        <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                      </td>
                                    </tr>
                                    <tr class="border-black o_total">
                                      <td name="td_amount_total_label">
                                        <strong>Total</strong>
                                      </td>
                                      <td class="text-right">
                                        <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                      </td>
                                    </tr>
                                  </table>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <!-- end of line items section -->

                        <div class="col-12">
                          <p t-field="o.note" />
                          <div class="oe_structure" />
                        </div>
                      </div>

                      <!-- footer section -->
                      <div style="page-break-inside: avoid;">
                        <div class="row">
                          <div class="col-12 border border-dark px-5">
                            <div>
                              <div style="font-weight: 900 !important;">
                  If you have any questions about this purchase order, please contact
                              </div>
                              <hr class="border-dark" />
                              <div> Email:<t t-esc="o.company_id.email" />
 Phone: <t t-esc="o.company_id.phone" />
                            </div>
                          </div>
                          <hr class="border-dark" />

                          <div class="row">

                            <!-- col1 -->
                            <div class="col-4">
                              <div class="row">
                                <div class="col-6" style="height: 60px;">
                                  <strong>Created By</strong>
                                </div>
                                <div class="col-6" style="height: 60px;">
                                  <span t-esc="o.create_uid.name" />
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6" >
                                  <strong>Signature:</strong>
                                </div>
                                <div class="col-6">
                                  <div >
                                    <div t-if="o.create_uid.user_signature" t-field="o.create_uid.user_signature" t-options="{'widget': 'html'}" class="sign"/>
                                  </div>
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6">
                                  <strong>Date:</strong>
                                </div>
                                <div class="col-6">
                                  <span t-field="o.create_date" t-options="{'widget':'date'}" />
                                </div>
                              </div>
                            </div>
                            <!-- end of col1 -->

                            <!-- col2 -->
                            <div class="col-4">
                              <div class="row">
                                <div class="col-6" style="height: 60px;">
                                  <strong>Checked By</strong>
                                </div>
                                <div class="col-6" style="height: 60px;">
                                  <span t-if="o.checked_by" t-esc="o.checked_by.name" />
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6" >
                                  <strong>Signature:</strong>
                                </div>
                                <div class="col-6">
                                  <div >
                                    <t t-if="o.state == 'approved'">
                                      <div t-if="o.checked_by.user_signature" t-field="o.checked_by.user_signature" t-options="{'widget': 'html'}" class="sign"/>
                                    </t>
                                  </div>
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6">
                                  <strong>Date:</strong>
                                </div>
                                <div class="col-6">
                                  <t t-if="o.state == 'approved'">
                                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')" />
                                  </t>
                                </div>
                              </div>
                            </div>
                            <!-- end of col2 -->

                            <!-- col3 -->
                            <div class="col-4">
                              <div class="row">
                                <div class="col-6" style="height: 60px;">
                                  <strong>Approved By</strong>
                                </div>
                                <div class="col-6" style="height: 60px;">
                                  <t t-if="o.state in ['approved','pm','coo','ceo']">
                                    <span t-if="o.approval_by" t-esc="o.approval_by.name" />
                                  </t>
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6" >
                                  <strong>Signature:</strong>
                                </div>
                                <div class="col-6">
                                  <div >
                                    <t t-if="o.state in ['approved','pm','coo','ceo']">

                                      <div t-if="o.approval_by.user_signature" t-field="o.approval_by.user_signature" t-options="{'widget': 'html'}" class="sign"/>
                                    </t>
                                  </div>
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6">
                                  <strong>Date:</strong>
                                </div>
                                <div class="col-6">
                                  <t t-if="o.state in ['approved','pm','coo','ceo']">
                                    <span t-esc="o.approved_date" />
                                  </t>
                                </div>
                              </div>
                            </div>
                            <!-- end of cole -->
                          </div>

                          <!-- ####### -->
                          <hr class="border-dark" />

                          <div class="row">

                            <!-- col2 -->
                            <div class="col-6">
                              <div class="row">
                                <div class="col-6">
                                  <strong>Authorised by CFO</strong>
                                </div>
                                <div class="col-6">
                                  <t t-if="o.state in ['approved']">
                                    <span t-if="o.ceo" t-esc="o.ceo.name" />
                                  </t>
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6" >
                                  <strong>Signature:</strong>
                                </div>
                                <div class="col-6">
                                  <t t-if="o.state == 'approved'">
                                    <div >
                                      <t t-if="o.state == 'approved' and o.require_ceo">
                                        <div t-if="o.ceo.user_signature" t-field="o.ceo.user_signature" t-options="{'widget': 'html'}" class="sign"/>
                                      </t>
                                    </div>
                                  </t>
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6">
                                  <strong>Date:</strong>
                                </div>
                                <div class="col-6">
                                  <t t-if="o.state == 'approved' and o.require_ceo">
                                    <span t-esc="o.ceo_approval_date" />
                                  </t>
                                </div>
                              </div>
                            </div>
                            <!-- end of col2 -->

                            <!-- col1 -->
                            <div class="col-4">
                              <div class="row">
                                <div class="col-6">
                                  <strong>Accepted By</strong>
                                </div>
                                <div class="col-6">
                                  <!-- <span t-esc="o.create_uid.name" /> -->
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6" >
                                  <strong>Signature:</strong>
                                </div>
                                <div class="col-6">
                                  <div >

                                  </div>
                                </div>
                              </div>
                              <div class="row">
                                <div class="col-6">
                                  <strong>Date:</strong>
                                </div>
                                <div class="col-6">
                                  <!-- <span t-field="o.create_date" t-options="{'widget':'date'}" /> -->
                                </div>
                              </div>
                            </div>
                            <!-- end of col1 -->

                            <!-- col3 -->
                            <div class="col-2">

                            </div>
                            <!-- end of cole -->
                          </div>
                          <div class="row" t-if="o.use_purchase_terms" style="page-break-before: always;">
                            <div class="col-12">
                              <p>
                                <b>Terms and Conditons</b>
                              </p>
                              <p t-field="o.terms_conditions"/>

                            </div>
                          </div>


                        </div>
                      </div>
                    </div>

                    <!-- end of footer section -->

                    <div class="footer">
                      <div>
            Everything Solar
                      </div>
                    </div>
      </t>
    </template>
  </data>
</odoo>